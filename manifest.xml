<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  MANIFESTE DU COMPLÉMENT "Assistant IA" pour Word
  ================================================
  N'installez PAS ce fichier tel quel : ouvrez la page en ligne du panneau
  (https://votre-pseudo.github.io/assistant-ia-word/taskpane.html) et cliquez sur
  "Télécharger le manifeste pour Word". Le fichier téléchargé contient la bonne adresse.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>7092a8ab-8510-4129-9c0f-f09dcf861792</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Khalil</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Assistant IA"/>
  <Description DefaultValue="Panneau latéral pour reformuler, corriger, expliquer et résumer du texte avec l'IA."/>
  <IconUrl DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/taskpane.html"/>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="AssistantIAGroup">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="AssistantIAButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>AssistantIAPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://VOTRE-PSEUDO.github.io/assistant-ia-word/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Assistant IA est installé"/>
        <bt:String id="Group.Label" DefaultValue="Assistant IA"/>
        <bt:String id="Button.Label" DefaultValue="Assistant IA"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Onglet Accueil > bouton Assistant IA pour ouvrir le panneau."/>
        <bt:String id="Button.Tooltip" DefaultValue="Ouvre le panneau IA : reformuler, corriger, expliquer, résumer…"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
